# Preferred for production: point the frontend at your own backend proxy.
# The proxy should call MiniMax with the server-side API key.
VITE_MINIMAX_PROXY_URL=/api/minimax/chat

# Server-side only. Configure these in Vercel Environment Variables.
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_API_URL=https://api.minimaxi.com/v1/chat/completions
MINIMAX_MODEL=MiniMax-M2.7

# Local prototype only. Do not expose this in a public frontend build.
# VITE_MINIMAX_API_KEY=your_minimax_api_key
# VITE_MINIMAX_API_URL=https://api.minimaxi.com/v1/chat/completions
VITE_MINIMAX_MODEL=MiniMax-M2.7
